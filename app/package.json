{
	"name": "portal-site",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	},
	"scripts": {
		"import": "node scripts/import.mjs",
		"predev": "node scripts/import.mjs",
		"dev": "vite dev",
		"prebuild": "node scripts/import.mjs",
		"build": "vite build",
		"preview": "vite preview",
